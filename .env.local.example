# Copy this file to .env.local and fill in your own project's values.
# Get these from your Supabase project: Settings -> API
# NEVER commit .env.local, and never paste real key values into a chat, issue, or PR.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security. Do NOT prefix with NEXT_PUBLIC_.
# Only ever set this in your local .env.local and in your deployment platform's
# encrypted environment variable settings (e.g. Vercel Project Settings -> Environment Variables).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
